# Public URL of the deployed site (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nvtechnology.example.com

# Resend (https://resend.com) — leave empty to log submissions to the server console instead
RESEND_API_KEY=
# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@nvtechnology.example.com
# Verified sender address/domain in Resend
CONTACT_FROM_EMAIL="NV Technology Website <noreply@nvtechnology.example.com>"
